<?php 

function entityfunctionality_entity_info_alter(&$entity_info) {
    $entity_info['node']['entity class'] = 'NodeEntity';
}

function entityfunctionality_permission() {
    return array(
        'entity access' => array(
            'title' => t('Access to Entity'),
        )
    );
}

function entity_node_label($entity, $entity_type = NULL) {
    return $entity->getBundleTitle();
}

function entityfunctionality_set_entity_bundle_node($entityType, $node) {
    if(is_object($node) && property_exists($node, 'nid')) {
        $entities = entity_load($entityType, FALSE, array(
            'entity_node_bundle_id' => $node->nid
        ));
        $entity = reset($entities);
    } else {
        $entity = entity_get_controller($entityType)->create(array());
    }
    return $entity;
}

function entityfunctionality_set_entity_reference_node($entityType, $node) {
    if(is_object($node) && property_exists($node, 'nid')) {
        $entity = entity_load($entityType, FALSE, array(
            'entity_node_reference_id' => $node->nid
        ));
    } else {
        $entity = entity_get_controller($entityType)->create(array());
    }
    return $entity;
}

function entityfunctionality_set_entity_reference_node_entity($entityType, $entity) {
    if(!is_null($entity->getEntityId())) {
        $entity = entity_load($entityType, FALSE, array(
            'entity_node_reference_id' => $entity->getBundle()
        ));
    } else {
        $entity = entity_get_controller($entityType)->create(array());
    }
    return $entity;
}

function dannyscomedyclub_entity_access($op, $entity_type, $entity = NULL, $account = NULL) {
    global $user;
    
    $perms = user_role_permissions($user->roles);
    
    return dannyscomedyclub_entity_permissions($perms, $entity_type);
}

function dannyscomedyclub_entity_permissions($perms, $entity_type = '') {
    if(!empty($entity_type)) {
        $entity_type = $entity_type . ' ';
    }
    if(is_array($perms)) {
        foreach($perms as $role_id => $permissions) {
            if(in_array('entity ' . $entity_type . 'access', $permissions)) {
                return TRUE;
            }
        }
    }
    return FALSE;
}

?>