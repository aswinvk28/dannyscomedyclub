<?php 

function performer_schema() {
    $schema = array();
    
    $schema['dcc_entity_performer'] = array(
        'description' => 'Performers of the club',
        'fields' => array(
            'performer_id' => array(
                'type' => 'serial', 
                'unsigned' => TRUE, 
                'not null' => TRUE),
            'entity_node_bundle_id' => array(
                'type' => 'int',
                'unsigned' => TRUE,
                'not null' => TRUE),
            'entity_user_id' => array(
                'type' => 'int',
                'unsigned' => TRUE,
                'not null' => FALSE,
                'default' => NULL),
            'performer_email' => array(
                'type' => 'varchar',
                'length' => 128,
                'not null' => FALSE,
                'default' => NULL),
            'performer_fb' => array(
                'type' => 'varchar',
                'length' => 128,
                'not null' => FALSE,
                'default' => NULL),
            'performer_twitter' => array(
                'type' => 'varchar',
                'length' => 128,
                'not null' => FALSE,
                'default' => NULL),
            'performer_yt' => array(
                'type' => 'varchar',
                'length' => 128,
                'not null' => FALSE,
                'default' => NULL),
            'performer_website' => array(
                'type' => 'varchar',
                'length' => 128,
                'not null' => FALSE,
                'default' => NULL),
            'performer_opt' => array(
                'type' => 'blob',
                'not null' => FALSE,
                'default' => NULL)
        ),
        'indexes' => array('node_bundle' => array('entity_node_bundle_id')),
        'unique keys' => array('user' => array('entity_user_id')),
        'primary key' => array('performer_id')
    );
    
    return $schema;
}

