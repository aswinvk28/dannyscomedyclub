function performer_permission() {
    return array(
        'entity performer access' => array(
            'title' => t('Performer Entity Access'),
            'description' => t('Manage, view, edit and delete all performer entity content.'),
            'restrict access' => TRUE,
        )
    );
}

function performer_node_access($node, $op, $account) {
    if($op == 'view' && $node->type == 'artistes' && $node->status == 0) {
        return array(NODE_ACCESS_DENY);
    }
}

