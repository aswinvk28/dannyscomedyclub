function event_permission() {
    return array(
        'entity performance access' => array(
            'title' => t('Performance Entity Access'),
            'description' => t('Manage, view, edit and delete all performance entity content.'),
            'restrict access' => TRUE,
        ),
        'entity show access' => array(
            'title' => t('Show Entity Access'),
            'description' => t('Manage, view, edit and delete all show entity content.'),
            'restrict access' => TRUE,
        )
    );
}

